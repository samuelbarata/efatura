{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "gitAuthor": "Renovate Bot <renovate@barata.pt>",
  "labels": [
    "renovate"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "description": "Dependency bumps are chores: the published crate only changes when Cargo.toml requirements do, and then a maintainer says so with a fix(deps): commit. Without this every lockfile bump would publish a release.",
      "matchManagers": [
        "cargo"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    }
  ]
}
